# Loaded for interactive shells

# In-memory size
export HISTSIZE=10000
# File size
export HISTFILESIZE=1000000
export SAVEHIST="${HISTFILESIZE}"
readonly HISTFILESIZE SAVEHIST HISTSIZE 2>/dev/null

case "${BUILDENV-}" in
"") ;;
*)
        PS1="(buildenv) ${PS1}"
	;;
esac

# herdr >= 0.9.2 sets TERM_PROGRAM=herdr, which Claude Code doesn't
# recognize, so it stops sending OSC 8 hyperlinks inside panes.
# https://github.com/herdrdev/herdr/issues/4748
case "${TERM_PROGRAM:-}" in
herdr) export FORCE_HYPERLINK=1 ;;
esac

source_local "${HOME}/.rc.common"
# vim: set filetype=sh:
