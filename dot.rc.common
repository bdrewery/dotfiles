# Loaded for interactive shells

# In-memory size
export HISTSIZE=5000
# File size
export HISTFILESIZE=1000000
export SAVEHIST="${HISTFILESIZE}"
readonly HISTFILESIZE SAVEHIST HISTSIZE 2>/dev/null

case "${BUILDENV-}" in
"") ;;
*)
        PS1="(buildenv) ${PS1}"
	;;
esac


source_local "${HOME}/.rc.common"
# vim: set filetype=sh:
